# GoDark SDK credentials
# Copy this file to .env and fill in your API credentials.
# Create a key at https://app.godark-dex.com → Settings → API Key Management
GODARK_API_KEY_ID=
GODARK_API_SECRET=
GODARK_PASSPHRASE=

# Sequencer HPKE static public key (64 hex chars). Optional on testnet/devnet —
# the SDK bakes those pins (explicit arg / this env var still overrides).
# Required for localnet. Aliases: GDX_HPKE_STATIC_PUBKEY, GODARK_HPKE_STATIC_PUBLIC_KEY,
# VITE_GDX_HPKE_STATIC_PUBKEY. Legacy: GDX_NOISE_STATIC_PUBLIC_KEY, GODARK_NOISE_STATIC_PUBLIC_KEY.
# GDX_HPKE_STATIC_PUBLIC_KEY=

# Optional URL overrides (otherwise use SDK Environment preset):
# Testnet edge/REST: wss://api.godark-dex.com / https://api.godark-dex.com
# Devnet edge/REST:  wss://api.devnet.godark-dex.com / https://api.devnet.godark-dex.com
# Localnet (`gdx up`): ws://127.0.0.1:13300 / http://127.0.0.1:13300
# GODARK_EDGE_URL=
# GODARK_REST_URL=

# --- local `gdx up` stack (static key, no passphrase) ---
# GODARK_EDGE_URL=ws://127.0.0.1:13300
# GODARK_REST_URL=http://127.0.0.1:13300
# GODARK_API_KEY=test-key-1
# GDX_HPKE_STATIC_PUBLIC_KEY=1d61f116451fdfda1aa4aaf50b7200c3b362d0445bfa2d7ef1f80b3b8881a533
# fund via: gdx fund 00000000-0000-4000-8000-000000000001
