# Godark C++ examples -- environment
#
# Copy this file to `.env` (it is git-ignored) and fill in the values you
# need. Each example program calls `godark::examples::load_dotenv()` on
# startup, which walks up from the working directory looking for a `.env`
# file and merges its `KEY=VALUE` pairs into the process environment.
# Existing OS environment variables always win, so `KEY=value ./quickstart`
# still overrides whatever is here.

# ---------------------------------------------------------------------------
# WebSocket trading (quickstart, e2e_trading_smoke, full_trader_example)
# ---------------------------------------------------------------------------

GODARK_API_KEY_ID=gdk_...
GODARK_API_SECRET=...

# Bare static token (e.g. localnet edges with a fixed key list). When set,
# overrides GODARK_API_KEY_ID + GODARK_API_SECRET.
# GODARK_API_KEY=test-key-1

# WebSocket endpoint. Defaults to wss://api.godark-dex.com (testnet).
# GODARK_EDGE_URL=wss://api.godark-dex.com
# GDX_EDGE_URL is accepted as an alias. quickstart also falls back to
# GODARK_BASE_URL when neither EDGE_URL is set.
# GODARK_BASE_URL=ws://127.0.0.1:4000

# Resting limit price used by quickstart / e2e_trading_smoke. Override on
# environments that cap mark deviation (e.g. localnet at 1000 bps).
# GODARK_TEST_LIMIT_PRICE=90000

# Leave the limit order resting after quickstart finishes (skips the cancel).
# GODARK_SKIP_CANCEL=1

# ---------------------------------------------------------------------------
# REST (full_trader_rest)
# ---------------------------------------------------------------------------

# REST base URL. Defaults to https://api.godark-dex.com.
# GDX_REST_URL=https://api.godark-dex.com

# REST credentials. id+secret is preferred; GDX_API_KEY is the legacy bare
# token used by some local edges.
# GDX_API_KEY_ID=gdk_...
# GDX_API_SECRET=...
# GDX_API_KEY=test-key-1

# ---------------------------------------------------------------------------
# Market data (market_data_example)
# ---------------------------------------------------------------------------

# Reuses GODARK_EDGE_URL / GDX_EDGE_URL above. Dev-only TLS bypass:
# GODARK_TLS_SKIP_VERIFY=1
# GDX_TLS_SKIP_VERIFY=1
